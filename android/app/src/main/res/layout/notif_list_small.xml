<?xml version="1.0" encoding="utf-8"?>
<!-- Sperrbildschirm-Liste (eingeklappt): die ersten Artikel direkt zum Abhaken.
     Eingeklappt stehen nur ~48 dp zur Verfügung – daher nur eine Zeile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/ns_slot_0"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/notif_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <ImageView
            android:id="@+id/ns_icon_0"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/ns_text_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ns_slot_1"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/notif_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <ImageView
            android:id="@+id/ns_icon_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/ns_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ns_slot_2"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/notif_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <ImageView
            android:id="@+id/ns_icon_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/ns_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/ns_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="28dp"
        android:gravity="center"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
</LinearLayout>
